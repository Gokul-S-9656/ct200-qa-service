# Copy this file to .env and fill in your own values.

# Which LLM provider to use. Options: "mock", "groq"
LLM_PROVIDER=mock

# Required only if LLM_PROVIDER=groq
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite database file (relational store: document tree + selections)
DATABASE_URL=sqlite:///./ct200.db

# TinyDB file (document store: LLM-generated test cases)
TINYDB_PATH=./tinydb_generations.json

# Path to the markdown manual ingested on startup
MANUAL_PATH=./data/ct200_manual.md
