# Copy this file to .env and fill in your own values.

# Which LLM provider to use. Options: "mock", "groq"
LLM_PROVIDER=mock

# Required only if LLM_PROVIDER=groq
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# How long to wait for a Groq response, and how many times to retry a
# transient failure (timeout, 429, 5xx) before giving up.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Max size for POST /documents/upload, in bytes. Default: 2 MB.
MAX_UPLOAD_SIZE_BYTES=2097152

# Comma-separated list of allowed browser origins for CORS. Leave empty
# (default) to disable CORS entirely -- only same-origin/non-browser
# clients can call the API. Never set this to "*"; the API has no auth.
CORS_ALLOW_ORIGINS=

# SQLite database file (relational store: document tree + selections)
DATABASE_URL=sqlite:///./ct200.db

# TinyDB file (document store: LLM-generated test cases)
TINYDB_PATH=./tinydb_generations.json

# Path to the markdown manual ingested on startup
MANUAL_PATH=./data/ct200_manual.md
